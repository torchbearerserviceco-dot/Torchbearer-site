# Resend (https://resend.com) API key used to send quote-request emails.
RESEND_API_KEY=

# Where quote requests get delivered.
QUOTE_TO_EMAIL=torchbearerserviceco@gmail.com

# Must be an address on a domain you've verified in Resend
# (Settings > Domains). Until you verify a domain, leave this
# as onboarding@resend.dev for testing only — it's rate-limited
# and not reliable for real customer traffic.
QUOTE_FROM_EMAIL=onboarding@resend.dev
